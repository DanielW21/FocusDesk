# FocusDesk local configuration template.
# Copy this file to .env.local and fill in local values.
#
# Values beginning with VITE_ are bundled into the renderer. Only put public
# configuration in VITE_ variables. Native-only values may be kept here with
# non-VITE names; never put refresh tokens, private API keys, or passwords in a
# VITE_ variable.

# Runtime/build profile
VITE_FOCUSDESK_ENV=local
VITE_FOCUSDESK_DEBUG=false

# Public Google OAuth configuration.
# The OAuth client ID is public for a desktop app; the refresh token is not.
VITE_FOCUSDESK_GOOGLE_CLIENT_ID=
VITE_FOCUSDESK_GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/calendar.calendarlist.readonly

# Native-only OAuth value. This is consumed by build-native.sh and is never
# exposed through the renderer's VITE_* environment.
FOCUSDESK_GOOGLE_CLIENT_SECRET=

# Optional public service endpoint for future integrations.
# VITE_FOCUSDESK_API_BASE_URL=

# Private/native values intentionally do not have renderer-facing VITE_ names.
# User/account tokens belong in macOS Keychain, not this file.
